#!/usr/bin/env bash
# claude-docker - Run Claude Code inside a sandboxed Docker container.
#
# This script builds the sandbox image on first use, then runs
# claude inside a container with the project directory mounted
# read-write and the ~/.claude config directory persisted.

set -euo pipefail

IMAGE_NAME="claude-code-sandbox"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DOCKERFILE_DIR="${SCRIPT_DIR}/../docker/claude-sandbox"

build_image() {
  docker build -t "${IMAGE_NAME}" \
    --build-arg HOST_HOME="${HOME}" "${DOCKERFILE_DIR}" >&2
}

# Rebuild when the image is missing, or was built for a different home. The
# image symlinks the host home to /home/node so the shared ~/.claude (which
# stores absolute paths, e.g. plugin install locations) resolves. A cached
# image built for the wrong home lacks that symlink, so config and credentials
# never persist and Claude re-onboards every launch.
IMAGE_HOME="$(docker image inspect \
  -f '{{index .Config.Labels "host_home"}}' "${IMAGE_NAME}" 2>/dev/null || true)"
if [ "${IMAGE_HOME}" != "${HOME}" ]; then
  echo "Building Claude sandbox image..." >&2
  build_image
fi

PROJECT_DIR="$(pwd)"
CONTAINER_HOME="/home/node"

# Extra project directories (e.g. the frontend repo next to this backend).
# Claude's own --add-dir flag is intercepted here so the directory can be
# mounted, then re-forwarded to claude with the resolved path:
#   claude-docker --add-dir ../frontend
# Also accepted, colon-separated: CLAUDE_DOCKER_EXTRA_DIRS=~/code/frontend
# Each directory is mounted read-write at its host path and gets its .env
# files shadowed like the main project's.
# Resolve to an absolute path, expanding a literal leading ~ (the shell does
# not expand it in the --add-dir=~/x form).
resolve_dir() {
  local dir="$1"
  case "${dir}" in
    "~") dir="${HOME}" ;;
    "~/"*) dir="${HOME}${dir#\~}" ;;
  esac
  # CDPATH would make cd echo the resolved path, corrupting the output
  CDPATH= cd -- "${dir}" && pwd
}

# Skip duplicates and the project dir itself: docker rejects a repeated
# mount destination, and the project is already mounted. Refuse the home
# directory and the filesystem root, mounting either defeats the sandbox.
add_extra_dir() {
  local dir
  dir="$(resolve_dir "$1")"
  case "${dir}" in
    /|"${HOME}")
      echo "refusing to mount ${dir}: it would defeat the sandbox" >&2
      exit 1
      ;;
  esac
  [ "${dir}" = "${PROJECT_DIR}" ] && return 0
  case " ${EXTRA_DIRS[*]-} " in *" ${dir} "*) return 0 ;; esac
  EXTRA_DIRS+=("${dir}")
}

EXTRA_DIRS=()

# Always mount the shared scratch directory when it exists
[ -d "${HOME}/claude-shared" ] && add_extra_dir "${HOME}/claude-shared"

if [ -n "${CLAUDE_DOCKER_EXTRA_DIRS:-}" ]; then
  IFS=':' read -ra _dirs <<< "${CLAUDE_DOCKER_EXTRA_DIRS}"
  for _dir in "${_dirs[@]}"; do
    [ -n "${_dir}" ] || continue
    add_extra_dir "${_dir}"
  done
fi

ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --add-dir)
      [ $# -ge 2 ] || { echo "--add-dir requires a path" >&2; exit 1; }
      add_extra_dir "$2"
      shift 2
      ;;
    --add-dir=*)
      add_extra_dir "${1#*=}"
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

# Container name: claude-{project}-{instance}
PROJECT_SLUG="$(basename "${PROJECT_DIR}")"
if [ -n "${CLAUDE_BUFFER_NAME:-}" ]; then
  INSTANCE="${CLAUDE_BUFFER_NAME##*:}"
  INSTANCE="${INSTANCE%\*}"
  CONTAINER_NAME="claude-${PROJECT_SLUG}-${INSTANCE}"
else
  CONTAINER_NAME="claude-${PROJECT_SLUG}"
fi
CONTAINER_NAME="$(echo "${CONTAINER_NAME}" | \
  tr -cs 'a-zA-Z0-9_.-' '-' | sed 's/^[^a-zA-Z0-9]*//;s/-$//')"

CLAUDE_DIR="${HOME}/.claude"
CLAUDE_STATE_DIR="${HOME}/.local/state/claude"
mkdir -p "${CLAUDE_DIR}" "${CLAUDE_STATE_DIR}"

# Claude writes its global config atomically (temp file + rename). The default
# location, a single-file bind mount of ~/.claude.json, can't be renamed over,
# and the container home is read-only, so every config write is lost and Claude
# re-prompts (theme, folder trust) on each launch. Point CLAUDE_CONFIG_DIR at the
# mounted ~/.claude directory instead: there the config is a regular file in a
# writable mount, so atomic writes persist. Seed it from the host's global config
# on first use so onboarding, theme and account carry over.
CONFIG_JSON="${CLAUDE_DIR}/.claude.json"
if [ ! -f "${CONFIG_JSON}" ] && [ -f "${HOME}/.claude.json" ]; then
  cp "${HOME}/.claude.json" "${CONFIG_JSON}"
fi

DOCKER_ARGS=(
  --rm
  -it
  # Run under the host home path (symlinked to /home/node in the image) so
  # absolute paths in the shared ~/.claude config resolve consistently.
  -e HOME="${HOME}"
  -e TERM=xterm-256color
  -e INSIDE_EMACS=
  -e CLAUDE_CONFIG_DIR="${CONTAINER_HOME}/.claude"
  # Read by bin/claude-statusline to show a sandbox badge in the Claude UI
  -e CLAUDE_DOCKER_SANDBOX="${CONTAINER_NAME}"
  -v "${PROJECT_DIR}:${PROJECT_DIR}:z"
  -v "${CLAUDE_DIR}:${CONTAINER_HOME}/.claude:z"
  # Note: ~/.local/share/claude is NOT mounted. It holds the versioned claude
  # binary the launcher symlinks to; mounting the host's copy shadows the image's
  # baked-in version, dangling the symlink (exit 127). The image owns the version
  # (auto-updater is off, update = rebuild), so keep it self-contained.
  -v "${CLAUDE_STATE_DIR}:${CONTAINER_HOME}/.local/state/claude:z"
  -w "${PROJECT_DIR}"
  --user "$(id -u):$(id -g)"
  --cap-drop=ALL
  --security-opt=no-new-privileges
  --read-only
  # exec where builds and test binaries run; sized so a runaway process
  # cannot eat host RAM through an unbounded tmpfs (default: half of RAM)
  --tmpfs /tmp:exec,size=1g
  --tmpfs "${CONTAINER_HOME}/.cache:exec,size=2g"
  --tmpfs "${CONTAINER_HOME}/.config:size=64m"
  --tmpfs "${CONTAINER_HOME}/.npm:exec,size=1g"
  --pids-limit=512
  --memory=4g
  --name "${CONTAINER_NAME}"
)

for dir in ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"}; do
  DOCKER_ARGS+=(-v "${dir}:${dir}:z")
done

# Read by bin/claude-statusline to list the mounted extra directories
if [ -n "${EXTRA_DIRS[*]-}" ]; then
  DOCKER_ARGS+=(-e CLAUDE_DOCKER_DIRS="$(IFS=:; printf '%s' "${EXTRA_DIRS[*]}")")
fi

# Network: open egress by default. Set CLAUDE_DOCKER_NET_FILTER=1 to
# instead join an internal network with no route out, where egress goes
# through a squid sidecar (dual-homed on the internal net and the
# default bridge) that only allows domains listed in
# docker/claude-sandbox/allowed-domains.txt. Filtering is by the host
# named in the CONNECT request, so it survives CDN IP churn.
DOCKER_SOCK="/var/run/docker.sock"
PROXY_NAME="claude-docker-proxy"
EGRESS_PROXY="claude-egress-proxy"

if [ "${CLAUDE_DOCKER_NET_FILTER:-0}" = "1" ]; then
  NET="claude-docker-net"
  NET_OPTS=(--internal)
else
  NET="claude-docker-open-net"
  NET_OPTS=()
fi

if ! docker network inspect "${NET}" >/dev/null 2>&1; then
  docker network create ${NET_OPTS[@]+"${NET_OPTS[@]}"} "${NET}" >/dev/null
fi
DOCKER_ARGS+=(--network "${NET}")

if [ "${CLAUDE_DOCKER_NET_FILTER:-0}" = "1" ]; then
  if ! docker container inspect -f '{{.State.Running}}' \
       "${EGRESS_PROXY}" 2>/dev/null | grep -q true; then
    docker rm -f "${EGRESS_PROXY}" >/dev/null 2>&1 || true
    docker run -d \
      --name "${EGRESS_PROXY}" \
      --network "${NET}" \
      --restart unless-stopped \
      -v "${DOCKERFILE_DIR}/squid.conf:/etc/squid/squid.conf:ro,z" \
      -v "${DOCKERFILE_DIR}/allowed-domains.txt:/etc/squid/allowed-domains.txt:ro,z" \
      ubuntu/squid >/dev/null
    docker network connect bridge "${EGRESS_PROXY}"
  fi

  DOCKER_ARGS+=(
    # Blackhole external DNS: the proxy resolves hostnames (CONNECT
    # carries the name as a string), and squid only looks up domains
    # that pass the allowlist, so the container needs no external DNS.
    # Docker's embedded DNS still answers container names itself and
    # only forwards unknown names upstream; 127.0.0.1 dies on the host,
    # so exfiltration via DNS lookups never leaves the machine.
    --dns 127.0.0.1
    -e HTTP_PROXY="http://${EGRESS_PROXY}:3128"
    -e HTTPS_PROXY="http://${EGRESS_PROXY}:3128"
    -e http_proxy="http://${EGRESS_PROXY}:3128"
    -e https_proxy="http://${EGRESS_PROXY}:3128"
    -e NO_PROXY="localhost,127.0.0.1,${PROXY_NAME}"
    -e no_proxy="localhost,127.0.0.1,${PROXY_NAME}"
    # Direct port 22 is blocked on the internal net, so tunnel
    # git-over-SSH through the proxy as a CONNECT to :22.
    -e GIT_SSH_COMMAND="ssh -o ProxyCommand=\"nc -X connect -x ${EGRESS_PROXY}:3128 %h %p\""
  )
fi

# Docker socket proxy - gives read-only visibility into
# containers (ps, inspect, logs) without write access.
# POST/EXEC stay off: a write call to the host daemon (which
# runs as root) would let this container spawn a sibling that
# mounts the host filesystem, escaping the sandbox entirely.
if [ -S "${DOCKER_SOCK}" ]; then
  if ! docker container inspect -f '{{.State.Running}}' \
       "${PROXY_NAME}" 2>/dev/null | grep -q true; then
    docker rm -f "${PROXY_NAME}" >/dev/null 2>&1 || true
    docker run -d \
      --name "${PROXY_NAME}" \
      --network "${NET}" \
      --restart unless-stopped \
      -v "${DOCKER_SOCK}:/var/run/docker.sock:ro" \
      -e CONTAINERS=1 \
      -e EXEC=0 \
      -e POST=0 \
      -e LOG=1 \
      -e INFO=1 \
      -e IMAGES=0 \
      -e NETWORKS=0 \
      -e VOLUMES=0 \
      -e SERVICES=0 \
      -e TASKS=0 \
      -e BUILD=0 \
      -e COMMIT=0 \
      -e SWARM=0 \
      tecnativa/docker-socket-proxy >/dev/null
  fi
  # A proxy left over from a previous run may sit on another network
  # (e.g. after toggling CLAUDE_DOCKER_NET_FILTER); attach it to ours.
  docker network connect "${NET}" "${PROXY_NAME}" 2>/dev/null || true

  DOCKER_ARGS+=(-e DOCKER_HOST="tcp://${PROXY_NAME}:2375")
fi

# Pass through optional env vars if set
for var in ANTHROPIC_API_KEY CLAUDE_BUFFER_NAME; do
  if [ -n "${!var+x}" ]; then
    DOCKER_ARGS+=(-e "${var}")
  fi
done

# Forward SSH agent if available
MACOS_SSH_SOCK="/run/host-services/ssh-auth.sock"
if [ "$(uname)" = "Darwin" ] && [ -e "${MACOS_SSH_SOCK}" ]; then
  DOCKER_ARGS+=(
    -v "${MACOS_SSH_SOCK}:/tmp/ssh-agent.sock"
    -e SSH_AUTH_SOCK=/tmp/ssh-agent.sock
  )
elif [ -n "${SSH_AUTH_SOCK:-}" ]; then
  DOCKER_ARGS+=(
    -v "${SSH_AUTH_SOCK}:/tmp/ssh-agent.sock:z"
    -e SSH_AUTH_SOCK=/tmp/ssh-agent.sock
  )
fi

# Shadow .env files so secrets are never visible inside the container.
# Template files (.env.example and friends) stay readable, they exist
# to be read and hold no secrets.
while IFS= read -r -d '' envfile; do
  DOCKER_ARGS+=(-v "/dev/null:${envfile}:ro")
done < <(find "${PROJECT_DIR}" ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"} \
  \( -name node_modules -o -name .git \) -prune -o \
  \( -name '.env' -o -name '.env.*' \) \
  ! -name '.env.example' ! -name '.env.sample' ! -name '.env.template' \
  -print0 2>/dev/null)

# Forward git config (read-only)
if [ -f "${HOME}/.gitconfig" ]; then
  DOCKER_ARGS+=(
    -v "${HOME}/.gitconfig:${CONTAINER_HOME}/.gitconfig:ro,z"
  )
fi
XDG_GIT="${XDG_CONFIG_HOME:-${HOME}/.config}/git"
if [ -d "${XDG_GIT}" ]; then
  DOCKER_ARGS+=(
    -v "${XDG_GIT}:${CONTAINER_HOME}/.config/git:ro,z"
  )
fi

CLAUDE_ARGS=()
for dir in ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"}; do
  CLAUDE_ARGS+=(--add-dir "${dir}")
done

exec docker run "${DOCKER_ARGS[@]}" "${IMAGE_NAME}" \
  ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"} ${ARGS[@]+"${ARGS[@]}"}
